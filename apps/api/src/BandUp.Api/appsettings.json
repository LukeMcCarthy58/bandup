{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Authority": "",
    "Audience": "",
    "AuthorizedParties": []
  },
  "RateLimiting": {
    "GlobalPerMinute": 300,
    "PostingPerMinute": 10,
    "MessagingPerMinute": 30,
    "SensitivePerMinute": 5
  }
}
