# Copy to .env.local (never committed).

# Clerk (Dashboard → Configure → API keys). The publishable key is safe in the browser;
# the secret key is not, and is only used on the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Opt out of Clerk's SDK telemetry in development.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Where the BandUp API runs. Also allowed in the Content-Security-Policy (connect-src).
NEXT_PUBLIC_API_URL=http://localhost:5080

# Image CDN origin, once the Images epic is done. Allowed in img-src.
NEXT_PUBLIC_IMAGE_CDN_URL=

# End-to-end tests sign in as this Clerk user (create it in the Clerk dashboard).
E2E_CLERK_USER_EMAIL=
