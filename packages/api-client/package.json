{
  "name": "@bandup/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the BandUp API, generated from its OpenAPI document. Shared by web and (later) mobile.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
